# 이 파일은 Git에 올라가는 예시입니다. Vite는 .env.example을 읽지 않습니다.
# 로컬에서 쓰려면 복사하세요.
#   cp .env.example .env.local
# .env / .env.local 은 .gitignore 대상입니다.

# -----------------------------------------------------------------------------
# VITE_API_BASE_URL (런타임 사용: src/shared/api/endpoints.js)
# 백엔드 호스트. 끝의 / 는 제거된 뒤 명세서 경로와 붙습니다.
# 명세서 경로에는 /api 접두사가 없습니다. 붙이면 전부 404가 납니다.
#
# 개발에서 휴대폰(같은 네트워크의 IP 접속)으로도 확인하려면 /backend 를
# 쓰세요. vite.config.js의 프록시가 백엔드로 대신 전달해, 백엔드 CORS 허용
# 목록에 없는 origin에서도 동작합니다.
#   VITE_API_BASE_URL=/backend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://boardingpass.p-e.kr

# -----------------------------------------------------------------------------
# VITE_APP_ORIGIN (프론트 코드는 읽지 않음)
# 백엔드 CORS 허용 Origin 안내용입니다. 실제 Vercel URL로 바꿔 백엔드에 등록합니다.
# -----------------------------------------------------------------------------
VITE_APP_ORIGIN=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# VITE_API_MOCK (런타임 사용: src/shared/api/mock/backendStatus.js)
# 백엔드가 응답하지 않을 때 목 데이터로 화면을 그릴지 정합니다.
#   fallback (기본·비워 두면 이것) — 백엔드에 닿지 못할 때만 목을 씁니다.
#                                     (네트워크 실패·6초 무응답·502/503/504)
#   always — 백엔드를 부르지 않고 항상 목을 씁니다. 데모·오프라인 작업용.
#   off    — 목을 쓰지 않습니다. 실패가 그대로 화면에 보입니다.
# 목 데이터의 쓰기(발급·스캔·위시리스트 …)는 sessionStorage에 남습니다.
# -----------------------------------------------------------------------------
# VITE_API_MOCK=fallback

# 카카오 로그인 — 개발자 콘솔의 REST API 키.
# 공개 값이라 번들에 박혀도 된다. 비밀 키는 백엔드만 갖는다.
# 값이 없으면 카카오 버튼을 눌렀을 때 준비되지 않았다고 알린다.
#
# Redirect URI는 코드가 origin에서 만들어 쓴다(<origin>/auth/kakao/callback).
# 개발과 배포 주소를 모두 콘솔에 등록해야 한다. 한 글자라도 다르면 KOE006이 난다.
#   http://localhost:5173/auth/kakao/callback
#   https://boardingpass-seven.vercel.app/auth/kakao/callback
# 휴대폰(LAN IP) 접속은 origin이 http://<PC IP>:5173이라 콘솔에 없어 KOE006이
# 난다 — 그 주소까지 등록하지 않는 한 카카오 로그인만은 PC에서 확인한다.
VITE_KAKAO_CLIENT_ID=
