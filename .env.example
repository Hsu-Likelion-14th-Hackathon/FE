# 이 파일은 Git에 올라가는 예시입니다. Vite는 .env.example을 읽지 않습니다.
# 로컬에서 쓰려면 복사하세요.
#   cp .env.example .env.local
# .env / .env.local 은 .gitignore 대상입니다.

# -----------------------------------------------------------------------------
# VITE_API_BASE_URL (런타임 사용: src/shared/api/endpoints.js)
# 백엔드 호스트. 끝의 / 는 제거된 뒤 /api/... 와 붙습니다.
# 비우면 요청이 /api/session 처럼 상대경로가 되어 Vite 개발 서버로 갑니다.
# mock(MSW)만 쓸 때는 비워도 동작합니다. 실서버 연동 시 필수입니다.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://boardingpass.p-e.kr

# -----------------------------------------------------------------------------
# VITE_ENABLE_MSW (런타임 사용: src/main.jsx)
# npm run dev (import.meta.env.DEV=true) 일 때:
#   - 이 변수가 없거나 true  → MSW mock API 사용 (현재 기본)
#   - false                 → 실서버(VITE_API_BASE_URL)로 요청
# 프로덕션 빌드(DEV=false)에서는 이 값과 무관하게 MSW를 켜지 않습니다.
# -----------------------------------------------------------------------------
VITE_ENABLE_MSW=true

# -----------------------------------------------------------------------------
# VITE_APP_ORIGIN (프론트 코드는 읽지 않음)
# 백엔드 CORS 허용 Origin 안내용입니다. 실제 Vercel URL로 바꿔 백엔드에 등록합니다.
# -----------------------------------------------------------------------------
VITE_APP_ORIGIN=https://your-app.vercel.app
